// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Exchange {
  NSE   // National Stock Exchange
  BSE   // Bombay Stock Exchange
  MCX   // Multi Commodity Exchange
  NCD   // NSE Currency Derivatives
  BCD   // BSE Currency Derivatives
}

enum Segment {
  EQ      // Equity (Stocks)
  FO      // Futures & Options
  INDEX   // Index
  COM     // Commodities
}

model instrument {
  id             String       @id @default(uuid()) // Auto-incrementing Primary Key
  exchange       Exchange  // Enum: NSE, BSE, MCX, etc.
  segment        Segment   // Enum: EQ, FO, INDEX, COM, etc.
  symbol         String    // Stock/Future/Option name
  name            String
  isin            String
  short_name      String?
  trade_enabled   Boolean   @default(false) // Whether this instrument is selected for trading
  upstox_key      String?   // Upstox instrument key mapping
  zerodha_key     String?   // Zerodha instrument key mapping
  angelone_key    String?   // AngelOne instrument key mapping
  created_at      DateTime  @default(now()) // Timestamp when added
  updated_at      DateTime  @updatedAt // Auto-update timestamp

  @@unique([exchange, segment, symbol]) // Composite Unique Constraint
}

